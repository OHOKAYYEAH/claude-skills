LIGHTBOX = """<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Enlarged frame">
  <div class="lb-bar">
    <span class="lb-title" id="lb-title"></span>
    <span class="lb-count" id="lb-count"></span>
    <button type="button" id="lb-prev" aria-label="Previous frame">&lsaquo;</button>
    <button type="button" id="lb-next" aria-label="Next frame">&rsaquo;</button>
    <button type="button" id="lb-zoom">Actual size</button>
    <button type="button" id="lb-close">Close &middot; Esc</button>
  </div>
  <div class="lb-stage fit" id="lb-stage"><img id="lb-img" alt=""></div>
</div>
"""

LIGHTBOX_JS = """<script>
  (function () {
    var box = document.getElementById('lightbox');
    var stage = document.getElementById('lb-stage');
    var img = document.getElementById('lb-img');
    var title = document.getElementById('lb-title');
    var count = document.getElementById('lb-count');
    var prevBtn = document.getElementById('lb-prev');
    var nextBtn = document.getElementById('lb-next');
    var zoomBtn = document.getElementById('lb-zoom');
    var closeBtn = document.getElementById('lb-close');
    var shots = Array.prototype.slice.call(document.querySelectorAll('button.shot'));
    var index = 0;
    var lastFocus = null;

    var bar = [prevBtn, nextBtn, zoomBtn, closeBtn];
    if (shots.length < 2) { prevBtn.hidden = true; nextBtn.hidden = true; count.hidden = true; }

    function setFit(fit) {
      stage.classList.toggle('fit', fit);
      stage.classList.toggle('actual', !fit);
      zoomBtn.textContent = fit ? 'Actual size' : 'Fit to screen';
      if (!fit) { stage.scrollLeft = (stage.scrollWidth - stage.clientWidth) / 2; }
    }

    // Holding zoom + scroll across a swap turns the arrows into a blink comparator.
    function show(i, keepView) {
      index = (i + shots.length) % shots.length;
      var btn = shots[index];
      var source = btn.querySelector('img');
      var left = stage.scrollLeft;
      var top = stage.scrollTop;

      lastFocus = btn;
      img.src = source.src;
      img.alt = source.alt;
      title.textContent = btn.dataset.title || '';
      count.textContent = (index + 1) + ' / ' + shots.length;

      if (keepView) {
        stage.scrollLeft = left;
        stage.scrollTop = top;
      } else {
        setFit(true);
      }
    }

    function open(btn) { show(shots.indexOf(btn), false); box.hidden = false; closeBtn.focus(); }

    function close() {
      box.hidden = true;
      img.removeAttribute('src');
      if (lastFocus) { lastFocus.focus(); }
    }

    shots.forEach(function (btn) {
      btn.addEventListener('click', function () { open(btn); });
    });

    prevBtn.addEventListener('click', function () { show(index - 1, true); });
    nextBtn.addEventListener('click', function () { show(index + 1, true); });
    zoomBtn.addEventListener('click', function () { setFit(!stage.classList.contains('fit')); });
    closeBtn.addEventListener('click', close);
    stage.addEventListener('click', function (e) { if (e.target === stage) { close(); } });

    document.addEventListener('keydown', function (e) {
      if (box.hidden) { return; }
      if (e.key === 'Escape') { close(); return; }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1, true); return; }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1, true); return; }
      // Tab is trapped to the bar controls so focus can't wander behind the overlay.
      if (e.key === 'Tab') {
        e.preventDefault();
        var live = bar.filter(function (b) { return !b.hidden; });
        var at = live.indexOf(document.activeElement);
        live[(at + (e.shiftKey ? -1 : 1) + live.length) % live.length].focus();
      }
    });
  })();
</script>"""


PRINT_CSS = """
  @page { size: letter {{ORIENTATION}}; margin: 12mm; }
  @media print {
    :root, :root[data-theme="dark"], :root:not([data-theme="light"]) {
      --ground: #FFFFFF; --surface: #FFFFFF; --sunk: #F1F2EF;
      --ink: #1A1C19; --ink-soft: #4A4E47; --rule: #C7C9C2;
      --accent: #2B5E8E; --accent-soft: rgba(43, 94, 142, 0.12);
      --pass: #3F7D55; --fail: #9B2C2C; --note: #8A6D1F;
    }
    html, body { background: #FFFFFF; font-size: 12.5px; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .lightbox, .viewer-hint, .bar, .headerlink { display: none !important; }
    .sheet { max-width: none; padding: 0; gap: 14px; }
    /* A section moves to the next page whole, so a heading never strands above its frames;
       the image cap leaves room on that page for the heading, caption and frame bar. */
    .surface { padding-top: 10px; break-inside: avoid; }
    .surface-h, .caption, .doc h1, .doc h2, .doc h3 { break-after: avoid; }
    figure.frame, .meta, .callout, .scenarios li, .doc pre, .tablewrap, .doc img { break-inside: avoid; }
    footer { break-before: avoid; }
    .frame button.shot { cursor: default; }
    .frame img { max-height: 140mm; width: auto; max-width: 100%; margin: 0 auto; object-fit: contain; }
    main.doc { max-width: none; padding: 0; }
    .tablewrap { overflow: visible; }
  }
"""


# ---------------------------------------------------------------- cli


# Chromium's headless-only build (e.g. Fedora's chromium-headless), preferred where installed: a
# server needs no desktop libs. Not WeasyPrint: it can't lay out sheets (no grid auto-fit).
HEADLESS_SHELL = Path("/usr/lib64/chromium-browser/headless_shell")
BROWSERS = ("chromium-browser", "chromium", "google-chrome", "google-chrome-stable")


def pdf_browser():
    if HEADLESS_SHELL.is_file():
        return str(HEADLESS_SHELL)
    return next((b for b in map(shutil.which, BROWSERS) if b), None) or die(
        f"--pdf needs Chromium's headless shell or one of {', '.join(BROWSERS)} on PATH"
    )


def print_pdf(html_path):
    browser = pdf_browser()
    dest = html_path.with_suffix(".pdf")
    # A throwaway profile, so a running debug Chromium on the default profile can't swallow the job.
    with tempfile.TemporaryDirectory(prefix="present-pdf-") as profile:
        run = subprocess.run(
            [
                browser, "--headless=new", "--disable-gpu", "--no-first-run",
                f"--user-data-dir={profile}", "--no-pdf-header-footer",
                "--virtual-time-budget=8000",  # lets the web fonts land before printing
                f"--print-to-pdf={dest}", html_path.as_uri(),
            ],
            capture_output=True, text=True, timeout=120,
        )
    if run.returncode != 0 or not dest.is_file():
        die(f"pdf print failed for {html_path}: {run.stderr.strip()[-400:]}")
    return dest


def open_pages(paths):
    opener = os.environ.get("PRESENT_OPENER") or shutil.which("xdg-open") or shutil.which("open")
    if not opener:
        print("present: no opener found (set PRESENT_OPENER); pages were written but not opened", file=sys.stderr)
        return
    for p in paths:
        # Detached, so a cold browser doesn't hold this command open for its lifetime.
        subprocess.Popen([opener, p.as_uri()], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def cmd_sheet(args):
    try:
        manifest = json.loads(args.manifest.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        die(f"can't read manifest: {e}")
    base = args.manifest.resolve().parent
    lead = manifest.get("tag") or manifest.get("title", "")
    name = slugify(f"{lead} {manifest.get('kind', 'proof sheet')}")
    out = (args.out or base / f"{name}.html").expanduser().resolve()
    count, copied = build_sheet(manifest, base, out, args.linked)
    size = out.stat().st_size
    print(f"{out}  ({count} frames, {size // 1024} KB)")
    for rel, src in copied:
        print(f"  {rel} <- {src}")
    if size > ARTIFACT_PAGE_LIMIT:
        print("present: over 15 MB — too big for an Artifact page; use --linked or fewer frames", file=sys.stderr)
    if args.pdf:
        print(print_pdf(out))
    if args.open:
        open_pages([out])


def cmd_doc(args):
    roots = []
    for a in args.files:
        p = Path(a).expanduser().resolve()
        if not p.is_file():
            die(f"not a file: {p}")
        roots.append(p)

    queue, done = list(roots), {}
    while queue and len(done) < MAX_DOCS:
        src = queue.pop(0)
        if src in done:
            continue
        done[src] = render_doc(src, queue, not args.no_follow)

    for src in roots:
        print(done[src])
        if args.pdf:
            print(print_pdf(done[src]))
    if args.open:
        open_pages([done[src] for src in roots])


def main():
    ap = argparse.ArgumentParser(prog="present", description="Render pictures or a markdown doc as one styled HTML page.")
    sub = ap.add_subparsers(dest="mode", required=True)

    sp = sub.add_parser("sheet", help="screenshots + captions from a JSON manifest")
    sp.add_argument("manifest", type=Path)
    sp.add_argument("-o", "--out", type=Path)
    sp.add_argument("--linked", action="store_true", help="copy images to shots/ instead of embedding (Artifact publish)")
    sp.add_argument("--open", action="store_true", help="open with $PRESENT_OPENER, else xdg-open or open")
    sp.add_argument("--pdf", action="store_true", help="also print the page to a .pdf beside it")
    sp.set_defaults(run=cmd_sheet)

    dp = sub.add_parser("doc", help="markdown file(s) to a read-only styled copy")
    dp.add_argument("files", nargs="+")
    dp.add_argument("--open", action="store_true", help="open each root with $PRESENT_OPENER, else xdg-open or open")
    dp.add_argument("--no-follow", action="store_true", help="don't render linked .md files")
    dp.add_argument("--pdf", action="store_true", help="also print each root page to a .pdf beside it")
    dp.set_defaults(run=cmd_doc)

    args = ap.parse_args()
    args.run(args)


if __name__ == "__main__":
    main()
