#!/usr/bin/env python3
# summary: Render pictures or a markdown doc as one styled HTML page (engine behind /present).
"""present — render pictures or a markdown doc as ONE styled HTML page.

The engine behind the /present skill: every page that goes in front of the user is
built here, so sheets and documents share one design and callers never
hand-write HTML (base64 never passes through a tool call).

    present sheet sheet.json [-o out.html] [--linked] [--open] [--pdf]
    present doc report.md [more.md ...] [--open] [--no-follow] [--pdf]

Prints the path of each page it writes (for sheets, also the frame count).

SHEET — screenshots + captions from a JSON manifest. Output is self-contained
(images embedded as data: URIs) and lands beside the manifest as
<tag-or-title>-<kind>.html unless -o says otherwise. --linked copies the images
to <out dir>/shots/ and references them relatively instead: the form an
Artifact publishes, with shots/ as supporting files. Manifest (only "title" and
"sections" are required; relative "src" paths resolve against the manifest):

    {
      "title": "Onboarding wizard",
      "tag": "TICKET-612",
      "kind": "pre-push preview",
      "intro": "Real build on the hybrid FE, signed in as the fixture user.",
      "provenance": "Only when part of the sheet is illustrative, not captured.",
      "meta": [["Branch", "ticket-612-onboarding"], ["Widths", "1440 · 390"]],
      "scenarios": [{"verdict": "pass", "text": "Skip link", "frames": "01–02"}],
      "sections": [{
        "heading": "Step 1 — Connect your account",
        "caption": "The design calls baked in, so feedback is targeted.",
        "frames": [
          {"src": "step1-1440.png", "label": "desktop", "viewport": "1440"},
          {"src": "step1-390.png", "label": "phone", "viewport": "390"}
        ],
        "notes": [["copy", "Name in full everywhere."], "An untagged note."]
      }],
      "closing": "Not on this sheet, by necessity: ...",
      "access": [["ctrl+]", "Reopens this sheet."]],
      "footer": ["my-app", "ticket-612-onboarding"]
    }

Text fields accept `code` and **bold**; everything else is escaped. A frame's
"label" of before/after colours it as half of a pair. Frames in one section
share a row at one scale (columns sized by CSS width: "width", else the number
leading "viewport", else pixel width), so a phone frame sits beside a desktop
frame at true relative size.

DOC — markdown rendered to a read-only copy at ~/.cache/present/<hash>/<stem>.html,
so the source can't be edited by accident. Local images are embedded, so the
page survives being sent as one file. Relative .md links are rendered too and
point at those renders (local use only); --no-follow skips them.

--open hands each page to $PRESENT_OPENER if set (any command that takes a URL),
else xdg-open (Linux) or open (macOS). Without it nothing opens: the caller
decides delivery.

--pdf also prints each page to a .pdf beside it (headless Chromium, a throwaway
profile). The page's print stylesheet forces the light theme, keeps every frame
on one page and drops the viewer controls; a sheet whose frames are mostly wider
than tall prints landscape. For sending to people who won't open an HTML file.

One design for every page, whatever the project — no per-repo themes.

Load-bearing in the sheet viewer:
  - No target="_blank" and no links out: an Artifact's sandbox blocks top-level
    navigation, so enlargement happens in-page via the lightbox.
  - Arrow keys flip frames while HOLDING zoom + scroll, which turns a
    before/after pair into a blink comparator.
"""

import argparse
import base64
import datetime
import hashlib
import html
import json
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.parse import unquote, urlsplit

MIME = {
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".jpeg": "image/jpeg",
    ".webp": "image/webp",
    ".gif": "image/gif",
    ".svg": "image/svg+xml",
}
VERDICTS = {"pass", "note", "fail"}
ARTIFACT_PAGE_LIMIT = 15 * 1024 * 1024
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "present"
MAX_DOCS = 60  # a runaway link graph shouldn't render the whole repo


def die(msg):
    print(f"present: {msg}", file=sys.stderr)
    sys.exit(2)


def inline(text):
    out = html.escape(str(text), quote=False)
    out = re.sub(r"`([^`]+)`", r"<code>\1</code>", out)
    return re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", out)


def attr(text):
    return html.escape(str(text), quote=True)


def data_uri(path):
    return f"data:{MIME[path.suffix.lower()]};base64," + base64.b64encode(path.read_bytes()).decode()


def image_size(path):
    data = path.read_bytes()[:65536]
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return struct.unpack(">II", data[16:24])
    if data[:2] == b"\xff\xd8":
        i = 2
        while i + 9 < len(data):
            if data[i] != 0xFF:
                i += 1
                continue
            marker = data[i + 1]
            if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
                h, w = struct.unpack(">HH", data[i + 5 : i + 9])
                return w, h
            i += 2 + struct.unpack(">H", data[i + 2 : i + 4])[0]
    return None


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "page"


def page(title, body, extra_css="", script="", orientation="portrait"):
    return (
        PAGE.replace("{{TITLE}}", attr(title))
        .replace("{{EXTRA_CSS}}", extra_css)
        .replace("{{PRINT_CSS}}", PRINT_CSS.replace("{{ORIENTATION}}", orientation))
        .replace("{{BODY}}", body)
        .replace("{{SCRIPT}}", script)
    )


# ---------------------------------------------------------------- sheet


def css_width(frame, pixels):
    if frame.get("width"):
        return int(frame["width"])
    m = re.match(r"\s*(\d+)", str(frame.get("viewport", "")))
    if m:
        return int(m.group(1))
    return pixels[0] if pixels else 1


def build_sheet(manifest, base, out, linked):
    sections = manifest.get("sections") or die('manifest needs "sections"')
    title = manifest.get("title") or die('manifest needs "title"')
    tag = manifest.get("tag", "")
    kind = manifest.get("kind", "proof sheet")

    rendered = []
    number = 0
    copied = []
    wide = 0
    for s_index, section in enumerate(sections):
        frames = section.get("frames") or []
        cells = []
        widths = []
        for frame in frames:
            src = frame.get("src") or die(f"section {s_index + 1}: a frame has no src")
            path = (base / src).expanduser().resolve()
            if not path.is_file():
                die(f"missing image {path} (capture it or drop the frame; never describe one)")
            if path.suffix.lower() not in MIME:
                die(f"unsupported image type {path.suffix}")
            number += 1
            nn = f"{number:02d}"
            pixels = image_size(path)
            widths.append(css_width(frame, pixels))
            if pixels and pixels[0] > pixels[1]:
                wide += 1

            if linked:
                rel = f"shots/{nn}-{path.name}"
                dest = out.parent / rel
                dest.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(path, dest)
                copied.append((rel, path))
                img_src = rel
            else:
                img_src = data_uri(path)

            label = frame.get("label", "")
            state = label.lower() if label.lower() in ("before", "after") else ""
            dims = " · ".join(
                x for x in (frame.get("viewport", ""), f"{pixels[0]}×{pixels[1]}" if pixels else "") if x
            )
            head_title = " · ".join(x for x in (f"Frame {nn}", label, dims, section.get("heading", "")) if x)
            label_html = f'<span class="frame-state {state}">{inline(label)}</span>' if label else ""
            caption = f"<figcaption>{inline(frame['caption'])}</figcaption>" if frame.get("caption") else ""
            alt = frame.get("alt") or " — ".join(x for x in (section.get("heading", ""), label) if x) or f"frame {nn}"
            cells.append(
                f'<figure class="frame"><div class="frame-head"><span class="frame-no">{nn}</span>{label_html}'
                f'<span class="frame-dims">{inline(dims)}</span></div>'
                f'<button class="shot" type="button" data-title="{attr(head_title)}">'
                f'<img src="{img_src}" alt="{attr(alt)}"></button>{caption}</figure>'
            )

        if cells and len(cells) <= 4:
            columns = " ".join(f"minmax(0,{w}fr)" for w in widths)
            strip = f'<div class="strip row" style="--cols:{columns}">{"".join(cells)}</div>'
        elif cells:
            strip = f'<div class="strip wrap">{"".join(cells)}</div>'
        else:
            strip = ""

        notes = []
        for note in section.get("notes") or []:
            if isinstance(note, list):
                notes.append(f'<li><span class="pill">{inline(note[0])}</span>{inline(note[1])}</li>')
            else:
                notes.append(f"<li>{inline(note)}</li>")

        rendered.append(
            '<section class="surface">'
            + (
                f'<div class="surface-h"><span class="surface-no">{s_index + 1:02d}</span>'
                f"<h2>{inline(section['heading'])}</h2></div>"
                if section.get("heading")
                else ""
            )
            + (f'<p class="caption">{inline(section["caption"])}</p>' if section.get("caption") else "")
            + strip
            + (f'<ul class="notes">{"".join(notes)}</ul>' if notes else "")
            + "</section>"
        )

    if number == 0:
        die("no frames — a proof sheet with no captured image is not a proof sheet")

    parts = [
        '<header class="masthead">',
        f'<span class="ticket">{inline(tag)}</span>' if tag else "",
        f"<h1>{inline(title)}</h1>",
        f'<span class="sheet-kind">{inline(kind)}</span>',
        "</header>",
    ]
    if manifest.get("intro"):
        parts.append(f'<p class="intro">{inline(manifest["intro"])}</p>')
    if manifest.get("provenance"):
        parts.append(
            '<div class="callout provenance"><span class="callout-mark">Illustrative</span>'
            f'<p>{inline(manifest["provenance"])}</p></div>'
        )
    meta = list(manifest.get("meta") or []) + [["Frames", str(number)]]
    parts.append(
        '<dl class="meta">'
        + "".join(f"<div><dt>{inline(k)}</dt><dd>{inline(v)}</dd></div>" for k, v in meta)
        + "</dl>"
    )
    if manifest.get("scenarios"):
        rows = []
        for sc in manifest["scenarios"]:
            verdict = sc.get("verdict", "pass")
            if verdict not in VERDICTS:
                die(f"scenario verdict must be one of {sorted(VERDICTS)}, got {verdict!r}")
            ref = f'<span class="frame-ref">{inline(sc["frames"])}</span>' if sc.get("frames") else ""
            rows.append(f'<li><span class="verdict {verdict}">{verdict.upper()}</span>{inline(sc["text"])}{ref}</li>')
        parts.append(f'<section><p class="block-label">Scenarios walked</p><ul class="scenarios">{"".join(rows)}</ul></section>')
    parts.append('<p class="block-label viewer-hint">Click a frame to enlarge · ← → flips frames, holding zoom · Esc closes</p>')
    parts.extend(rendered)
    if manifest.get("closing"):
        parts.append(
            '<div class="callout closing"><span class="callout-mark">Not on this sheet</span>'
            f'<p>{inline(manifest["closing"])}</p></div>'
        )
    if manifest.get("access"):
        items = "".join(f"<li><kbd>{inline(k)}</kbd>{inline(v)}</li>" for k, v in manifest["access"])
        parts.append(f'<section class="access"><p class="block-label">Getting back here</p><ul>{items}</ul></section>')
    footer = [f"Assembled {datetime.date.today().isoformat()}"] + list(manifest.get("footer") or [])
    parts.append("<footer>" + "".join(f"<span>{inline(f)}</span>" for f in footer) + "</footer>")

    body = '<div class="sheet">\n' + "\n".join(p for p in parts if p) + "\n</div>\n" + LIGHTBOX
    out.parent.mkdir(parents=True, exist_ok=True)
    orientation = "landscape" if wide * 2 > number else "portrait"
    out.write_text(page(f"{tag} {title}".strip(), body, SHEET_CSS, LIGHTBOX_JS, orientation), encoding="utf-8")
    return number, copied


# ---------------------------------------------------------------- doc

DOC_EXTENSIONS = ["extra", "codehilite", "sane_lists", "toc", "admonition"]
DOC_EXTENSION_CONFIGS = {"codehilite": {"guess_lang": False}, "toc": {"permalink": "#"}}
LINK_RE = re.compile(r'(?P<attr>href|src)="(?P<url>[^"]+)"')


def doc_out(src):
    # Hash the absolute path so same-named docs can't collide; keep the stem as
    # the filename so a sent copy stays recognisable.
    digest = hashlib.sha1(str(src).encode()).hexdigest()[:10]
    return CACHE / digest / f"{src.stem}.html"


def code_css():
    from pygments.formatters import HtmlFormatter

    light = HtmlFormatter(style="default").get_style_defs(".codehilite")
    dark_sel = ':root:not([data-theme="light"]) .codehilite'
    dark = HtmlFormatter(style="monokai").get_style_defs(dark_sel)
    forced = HtmlFormatter(style="monokai").get_style_defs(':root[data-theme="dark"] .codehilite')
    return f"{light}\n@media (prefers-color-scheme: dark) {{\n{dark}\n}}\n{forced}\n"


def rewrite_links(body, src, queue, follow):
    def repl(m):
        url = m.group("url")
        if urlsplit(url).scheme or url.startswith(("#", "//", "mailto:")):
            return m.group(0)
        frag = ""
        if "#" in url:
            url, frag = url.split("#", 1)
            frag = "#" + frag
        if not url:
            return m.group(0)
        target = (src.parent / unquote(url)).resolve()
        if m.group("attr") == "src" and target.is_file() and target.suffix.lower() in MIME:
            return f'src="{data_uri(target)}"'
        if target.suffix.lower() in (".md", ".markdown") and target.is_file():
            if follow and target not in queue:
                queue.append(target)
            return f'{m.group("attr")}="{doc_out(target).as_uri()}{frag}"'
        if target.exists():
            return f'{m.group("attr")}="{target.as_uri()}{frag}"'
        return m.group(0)

    return LINK_RE.sub(repl, body)


def render_doc(src, queue, follow):
    try:
        import markdown
    except ImportError:
        die("doc mode needs python3-markdown + python3-pygments")
    text = src.read_text(encoding="utf-8")
    md = markdown.Markdown(extensions=DOC_EXTENSIONS, extension_configs=DOC_EXTENSION_CONFIGS)
    body = rewrite_links(md.convert(text), src, queue, follow)
    body = body.replace("<table>", '<div class="tablewrap"><table>').replace("</table>", "</table></div>")

    title = next((l.lstrip("# ").strip() for l in text.splitlines() if l.startswith("# ")), src.name)
    mtime = time.strftime("%Y-%m-%d %H:%M", time.localtime(src.stat().st_mtime))
    bar = f'<div class="bar"><span class="path">{html.escape(str(src))}</span><span>modified {mtime}</span></div>'
    dest = doc_out(src)
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(page(title, f'{bar}\n<main class="doc">{body}</main>', DOC_CSS + code_css()), encoding="utf-8")
    return dest


# ---------------------------------------------------------------- design

PAGE = """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{TITLE}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<style>
  :root {
    --ground: #E7E8E4; --surface: #FBFBF9; --sunk: #DEE0DB;
    --ink: #1A1C19; --ink-soft: #585C55; --rule: #C7C9C2;
    --accent: #2B5E8E; --accent-soft: rgba(43, 94, 142, 0.12);
    --pass: #3F7D55; --fail: #9B2C2C; --note: #8A6D1F;
    --display: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --body: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --data: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #15171A; --surface: #1E2126; --sunk: #101215;
      --ink: #E8EAE6; --ink-soft: #9AA09A; --rule: #323841;
      --accent: #6FA8DC; --accent-soft: rgba(111, 168, 220, 0.16);
      --pass: #6BAF83; --fail: #D97070; --note: #C9A945;
    }
  }
  :root[data-theme="dark"] {
    --ground: #15171A; --surface: #1E2126; --sunk: #101215;
    --ink: #E8EAE6; --ink-soft: #9AA09A; --rule: #323841;
    --accent: #6FA8DC; --accent-soft: rgba(111, 168, 220, 0.16);
    --pass: #6BAF83; --fail: #D97070; --note: #C9A945;
  }
  * { box-sizing: border-box; }
  html { background: var(--ground); }
  body {
    margin: 0; background: var(--ground); color: var(--ink);
    font-family: var(--body); font-size: 15px; line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  code {
    font-family: var(--data); font-size: 0.88em;
    background: var(--sunk); padding: 0.1em 0.35em; border-radius: 3px;
  }
  b, strong { font-weight: 600; color: var(--ink); }
  a { color: var(--accent); }
{{EXTRA_CSS}}
{{PRINT_CSS}}
</style>
</head>
<body>
{{BODY}}
{{SCRIPT}}
</body>
</html>
"""

